# Local Cloudflare Worker:
NEXT_PUBLIC_AIRMOUSE_WS_URL=ws://localhost:8787
NEXT_PUBLIC_QUESTION_BANK=external

# Custom games (server only; never expose the secret key with NEXT_PUBLIC_):
SUPABASE_SECRET_KEY=
ADMIN_PASSWORD=

# After `pnpm realtime:deploy`, use the workers.dev URL returned by Wrangler:
# NEXT_PUBLIC_AIRMOUSE_WS_URL=wss://airmouse-realtime.YOUR-SUBDOMAIN.workers.dev

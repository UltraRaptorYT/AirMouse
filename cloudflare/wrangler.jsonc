{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "airmouse-realtime",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
